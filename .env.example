# Server-only configuration. Never expose SUPABASE_SECRET_KEY in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-service-key
GEMINI_KEYS=your-primary-key,your-fallback-key
GEMINI_MODEL=gemini-3.1-flash-lite

# sqlite (default) or supabase
SDOC_STORE=sqlite
SDOC_DB_PATH=Averis1am/data/sdoc.db
SDOC_BUNDLE_PATH=sdoc-hackathon-bundle
SDOC_WAIT_SECONDS=86400
SDOC_TIMER_INTERVAL=60
SDOC_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Shared-secret demo auth. Use separate values for worker/admin in deployed demos.
SDOC_ADMIN_SECRET=change-me-admin
SDOC_WORKER_SECRET=change-me-worker
SDOC_SESSION_SECRET=change-me-long-random-session-secret
SDOC_COOKIE_SECURE=0

# Mailbox provider: gmail or outlook.
SDOC_MAILBOX_PROVIDER=gmail
SDOC_MAILBOX_SYNC_INTERVAL=60
SDOC_ATTACHMENT_ROOT=Averis1am/data

# Gmail OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/mailbox/oauth/callback
SDOC_GMAIL_QUERY=has:attachment newer_than:30d
SDOC_GMAIL_MAX_RESULTS=10

# Microsoft Outlook / Graph OAuth
# MICROSOFT_CLIENT_ID must be the Azure Overview > Application (client) ID GUID.
# MICROSOFT_CLIENT_SECRET is the Certificates & secrets secret Value.
MICROSOFT_CLIENT_ID=12345678-1234-1234-1234-123456789abc
MICROSOFT_CLIENT_SECRET=your-azure-client-secret-value
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8001/api/mailbox/oauth/callback
SDOC_OUTLOOK_QUERY=hasAttachments eq true
SDOC_OUTLOOK_MAX_RESULTS=10


# Authentication. Roles: worker (case queue) and admin (mailbox + analytics).
# Demo defaults are admin/admin123 and worker/worker123 -- change before deploying.
SDOC_AUTH=on
SDOC_SESSION_SECRET=
SDOC_ADMIN_PASSWORD=
SDOC_WORKER_PASSWORD=

# Mailbox provider: gmail | outlook
SDOC_MAILBOX_PROVIDER=gmail
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8001/api/mailbox/oauth/callback

# Where mailbox tokens, sync state and the spend ledger live: "file" (data/, default)
# or "supabase" (needs migration 20260921_003; use on hosts with a disposable disk).
SDOC_STATE_BACKEND=file
